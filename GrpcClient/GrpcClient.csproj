<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Core" Version="2.46.6" />
        <PackageReference Include="Grpc.Net.Client" Version="2.70.0-pre1" />
        <PackageReference Include="Grpc.Tools" Version="2.64.0" PrivateAssets="All" />
        <PackageReference Include="Google.Protobuf" Version="3.27.0" />
        <PackageReference Include="System.Net.Http.Json" Version="5.0.0" />
        <ProjectReference Include="..\GrpcServer\GrpcServer.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Protobuf Include="Protos/weather.proto" GrpcServices="Client" />
    </ItemGroup>
</Project>
